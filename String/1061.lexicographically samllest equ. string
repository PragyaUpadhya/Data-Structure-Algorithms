class Solution {
public:

    vector<int> parent;

    int find(int x) {

        if (parent[x] == x)
            return x;

        return parent[x] = find(parent[x]);
    }

    void unite(int a, int b) {

        int pa = find(a);
        int pb = find(b);

        if (pa == pb)
            return;

        // Keep smaller character as parent
        if (pa < pb)
            parent[pb] = pa;
        else
            parent[pa] = pb;
    }

    string smallestEquivalentString(string s1,
                                    string s2,
                                    string baseStr) {

        parent.resize(26);

        for (int i = 0; i < 26; i++) {
            parent[i] = i;
        }

        // Build equivalence groups
        for (int i = 0; i < s1.size(); i++) {

            unite(s1[i] - 'a',
                  s2[i] - 'a');
        }

        string ans = "";

        // Build result
        for (char c : baseStr) {

            ans += char(find(c - 'a') + 'a');
        }

        return ans;
    }
};
