class Solution {
public:
    int getLucky(string s, int k) {

        int sum = 0;

        // First conversion + first transform
        for (char ch : s) {
            int val = ch - 'a' + 1;

            while (val > 0) {
                sum += val % 10;
                val /= 10;
            }
        }

        // Remaining (k-1) transforms
        while (--k) {
            int temp = 0;

            while (sum > 0) {
                temp += sum % 10;
                sum /= 10;
            }

            sum = temp;
        }

        return sum;
    }
};
