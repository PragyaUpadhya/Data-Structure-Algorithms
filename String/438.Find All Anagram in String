class Solution {
public:
    vector<int> findAnagrams(string s, string p) {

        vector<int> ans;

        int n = s.size();
        int m = p.size();

        if (m > n)
            return ans;

        vector<int> pCount(26, 0);
        vector<int> wCount(26, 0);

        for (char ch : p)
            pCount[ch - 'a']++;

        for (int i = 0; i < m; i++)
            wCount[s[i] - 'a']++;

        if (pCount == wCount)
            ans.push_back(0);

        for (int i = m; i < n; i++) {

            wCount[s[i] - 'a']++;

            wCount[s[i - m] - 'a']--;

            if (pCount == wCount)
                ans.push_back(i - m + 1);
        }

        return ans;
    }
};438.
