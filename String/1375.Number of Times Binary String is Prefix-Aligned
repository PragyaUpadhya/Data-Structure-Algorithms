class Solution {
public:
    int numTimesAllBlue(vector<int>& flips) {
        int maxPos = 0;
        int ans = 0;

        for (int i = 0; i < flips.size(); i++) {
            maxPos = max(maxPos, flips[i]);

            if (maxPos == i + 1) {
                ans++;
            }
        }

        return ans;
    }
};
