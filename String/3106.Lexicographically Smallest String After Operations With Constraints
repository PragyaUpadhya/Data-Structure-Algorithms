class Solution {
public:
    string getSmallestString(string s, int k) {
        for (int i = 0; i < s.size(); i++) {
            int dist = min(s[i] - 'a', 26 - (s[i] - 'a'));

            if (dist <= k) {
                k -= dist;
                s[i] = 'a';
            } else {
                s[i] -= k;
                k = 0;
            }

            if (k == 0) {
                break;
            }
        }

        return s;
    }
};
