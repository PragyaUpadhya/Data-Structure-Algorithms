class Solution {
public:
    bool canConvertString(string s, string t, int k) {

        if (s.size() != t.size())
            return false;

        vector<int> freq(26, 0);

        for (int i = 0; i < s.size(); i++) {

            int shift = (t[i] - s[i] + 26) % 26;

            if (shift == 0)
                continue;

            int move = shift + 26 * freq[shift];

            if (move > k)
                return false;

            freq[shift]++;
        }

        return true;
    }
};
