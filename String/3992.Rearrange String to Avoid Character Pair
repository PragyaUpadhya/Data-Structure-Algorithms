class Solution {
public:
    string rearrangeString(string s, char x, char y) {
        string ans;

        // First put all y
        for (char c : s) {
            if (c == y)
                ans += c;
        }

        // Then put all characters except x and y
        for (char c : s) {
            if (c != x && c != y)
                ans += c;
        }

        // Finally put all x
        for (char c : s) {
            if (c == x)
                ans += c;
        }

        return ans;
    }
};
