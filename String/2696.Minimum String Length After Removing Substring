class Solution {
public:
    int minLength(string s) {
        int j = 0;

        for (int i = 0; i < s.size(); i++) {
            s[j++] = s[i];

            if (j >= 2 &&
                ((s[j - 2] == 'A' && s[j - 1] == 'B') ||
                 (s[j - 2] == 'C' && s[j - 1] == 'D'))) {
                j -= 2;
            }
        }

        return j;
    }
};
