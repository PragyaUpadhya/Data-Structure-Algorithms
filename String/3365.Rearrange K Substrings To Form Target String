class Solution {
public:
    bool isPossibleToRearrange(string s, string t, int k) {
        int n = s.size();
        int len = n / k;

        vector<string> a, b;

        for (int i = 0; i < n; i += len) {
            a.push_back(s.substr(i, len));
            b.push_back(t.substr(i, len));
        }

        sort(a.begin(), a.end());
        sort(b.begin(), b.end());

        return a == b;
    }
};
