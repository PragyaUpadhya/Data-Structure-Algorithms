class Solution {
public:
    string repeatLimitedString(string s, int repeatLimit) {

        vector<int> freq(26, 0);

        for (char ch : s)
            freq[ch - 'a']++;

        string ans;

        int i = 25;

        while (i >= 0) {

            while (i >= 0 && freq[i] == 0)
                i--;

            if (i < 0)
                break;

            int use = min(freq[i], repeatLimit);

            for (int k = 0; k < use; k++)
                ans += char(i + 'a');

            freq[i] -= use;

            if (freq[i] == 0)
                continue;

            int j = i - 1;

            while (j >= 0 && freq[j] == 0)
                j--;

            if (j < 0)
                break;

            ans += char(j + 'a');
            freq[j]--;
        }

        return ans;
    }
};
