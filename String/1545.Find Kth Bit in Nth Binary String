class Solution {
public:
    char findKthBit(int n, int k) {
        if (n == 1)
            return '0';

        int mid = (1 << (n - 1));

        // k is the middle position
        if (k == mid)
            return '1';

        // k is in the first half
        if (k < mid)
            return findKthBit(n - 1, k);

        // k is in the second half
        char bit = findKthBit(n - 1, (1 << n) - k);

        // invert the bit
        if (bit == '0')
            return '1';
        else
            return '0';
    }
};
