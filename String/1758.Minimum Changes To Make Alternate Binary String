class Solution {
public:
    int minOperations(string s) {
        int change1 = 0;
        int change2 = 0;

        for (int i = 0; i < s.size(); i++) {

            // Pattern: 010101...
            char expected1 = (i % 2 == 0) ? '0' : '1';

            // Pattern: 101010...
            char expected2 = (i % 2 == 0) ? '1' : '0';

            if (s[i] != expected1)
                change1++;

            if (s[i] != expected2)
                change2++;
        }

        return min(change1, change2);
    }
};
