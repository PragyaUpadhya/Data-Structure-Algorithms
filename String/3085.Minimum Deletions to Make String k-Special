class Solution {
public:
    int minimumDeletions(string word, int k) {
        vector<int> freq(26, 0);

        for (char c : word) {
            freq[c - 'a']++;
        }

        sort(freq.begin(), freq.end());

        int ans = word.size();

        for (int i = 0; i < 26; i++) {
            if (freq[i] == 0) continue;

            int deletions = 0;
            int minFreq = freq[i];

            for (int j = 0; j < 26; j++) {
                if (freq[j] == 0) continue;

                if (freq[j] < minFreq) {
                    deletions += freq[j];
                } else if (freq[j] > minFreq + k) {
                    deletions += freq[j] - (minFreq + k);
                }
            }

            ans = min(ans, deletions);
        }

        return ans;
    }
};
