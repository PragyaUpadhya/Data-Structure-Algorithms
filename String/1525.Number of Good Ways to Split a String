class Solution {
public:
    int numSplits(string s) {
        int n = s.size();
        vector<int> left(n), right(n);
        vector<int> freq(26, 0);
        int distinct = 0;

        for (int i = 0; i < n; i++) {
            if (freq[s[i] - 'a'] == 0) {
                distinct++;
            }
            freq[s[i] - 'a']++;
            left[i] = distinct;
        }

        fill(freq.begin(), freq.end(), 0);
        distinct = 0;

        for (int i = n - 1; i >= 0; i--) {
            if (freq[s[i] - 'a'] == 0) {
                distinct++;
            }
            freq[s[i] - 'a']++;
            right[i] = distinct;
        }

        int ans = 0;

        for (int i = 0; i < n - 1; i++) {
            if (left[i] == right[i + 1]) {
                ans++;
            }
        }

        return ans;
    }
};
