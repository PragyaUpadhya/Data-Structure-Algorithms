class Solution {
public:
    string decodeAtIndex(string s, int k) {

        long long size = 0;

        // Find total decoded length
        for (char c : s) {

            if (isdigit(c)) {
                size *= (c - '0');
            }
            else {
                size++;
            }
        }

        // Traverse backwards
        for (int i = s.size() - 1; i >= 0; i--) {

            char c = s[i];

            k %= size;

            // Found answer
            if (k == 0 && isalpha(c)) {
                return string(1, c);
            }

            if (isdigit(c)) {
                size /= (c - '0');
            }
            else {
                size--;
            }
        }

        return "";
    }
};
