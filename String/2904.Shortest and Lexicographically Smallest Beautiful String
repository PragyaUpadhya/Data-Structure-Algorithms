class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int n = s.size();
        int left = 0;
        int ones = 0;
        int minLen = INT_MAX;
        string ans = "";

        for (int right = 0; right < n; right++) {
            if (s[right] == '1')
                ones++;

            // We have exactly k ones
            while (ones == k) {
                int len = right - left + 1;

                if (len < minLen) {
                    minLen = len;
                    ans = s.substr(left, len);
                }
                else if (len == minLen) {
                    string current = s.substr(left, len);

                    if (ans.empty() || current < ans)
                        ans = current;
                }

                // Move left to find a shorter substring
                if (s[left] == '1')
                    ones--;

                left++;
            }
        }

        return ans;
    }
};

