class Solution {
public:
    int secondsToRemoveOccurrences(string s) {
        int seconds = 0;

        while (s.find("01") != string::npos) {
            string temp = s;

            for (int i = 0; i < s.size() - 1; i++) {
                if (s[i] == '0' && s[i + 1] == '1') {
                    temp[i] = '1';
                    temp[i + 1] = '0';
                }
            }

            s = temp;
            seconds++;
        }

        return seconds;
    }
};
