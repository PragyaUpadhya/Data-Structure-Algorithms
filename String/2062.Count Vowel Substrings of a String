class Solution {
public:
    bool isVowel(char c) {
        return c == 'a' || c == 'e' || c == 'i' ||
               c == 'o' || c == 'u';
    }

    int countVowelSubstrings(string word) {

        int ans = 0;
        int n = word.size();

        int last[5] = {-1, -1, -1, -1, -1};

        int start = 0;

        for (int i = 0; i < n; i++) {

            if (!isVowel(word[i])) {
                start = i + 1;

                for (int j = 0; j < 5; j++)
                    last[j] = -1;

                continue;
            }

            int index;

            if (word[i] == 'a') index = 0;
            else if (word[i] == 'e') index = 1;
            else if (word[i] == 'i') index = 2;
            else if (word[i] == 'o') index = 3;
            else index = 4;

            last[index] = i;

            int mn = n;

            for (int j = 0; j < 5; j++) {
                if (last[j] == -1) {
                    mn = -1;
                    break;
                }

                mn = min(mn, last[j]);
            }

            if (mn != -1)
                ans += mn - start + 1;
        }

        return ans;
    }
};
