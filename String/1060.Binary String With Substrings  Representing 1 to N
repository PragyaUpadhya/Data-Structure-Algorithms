class Solution {
public:
    bool queryString(string s, int n) {
        for (int i = 1; i <= n; i++) {
            string binary = "";
            int x = i;

            while (x > 0) {
                binary = char('0' + x % 2) + binary;
                x /= 2;
            }

            if (s.find(binary) == string::npos) {
                return false;
            }
        }

        return true;
    }
};
