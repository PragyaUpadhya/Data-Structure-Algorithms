
class Solution {
public:
    int ans = 0;

    void solve(vector<string>& arr, int index, string curr) {
        ans = max(ans, (int)curr.size());

        for (int i = index; i < arr.size(); i++) {
            string temp = curr + arr[i];

            set<char> st(temp.begin(), temp.end());

            if (st.size() == temp.size()) {
                solve(arr, i + 1, temp);
            }
        }
    }

    int maxLength(vector<string>& arr) {
        ans = 0;
        solve(arr, 0, "");
        return ans;
    }
};
