class Solution {
public:
    string evaluate(string s, vector<vector<string>>& knowledge) {
        // Sort knowledge by key
        sort(knowledge.begin(), knowledge.end());

        string ans = "";

        for (int i = 0; i < s.size(); i++) {

            if (s[i] != '(') {
                ans += s[i];
                continue;
            }

            int j = i + 1;

            while (s[j] != ')')
                j++;

            string key = s.substr(i + 1, j - i - 1);

            // Binary search
            int left = 0;
            int right = knowledge.size() - 1;
            string value = "?";

            while (left <= right) {
                int mid = left + (right - left) / 2;

                if (knowledge[mid][0] == key) {
                    value = knowledge[mid][1];
                    break;
                }
                else if (knowledge[mid][0] < key) {
                    left = mid + 1;
                }
                else {
                    right = mid - 1;
                }
            }

            ans += value;
            i = j;
        }

        return ans;
    }
};
