class Solution {
public:
    vector<int> divisibilityArray(string word, int m) {
        vector<int> ans;
        long long rem = 0;

        for (char c : word) {
            rem = (rem * 10 + (c - '0')) % m;

            if (rem == 0)
                ans.push_back(1);
            else
                ans.push_back(0);
        }

        return ans;
    }
};
