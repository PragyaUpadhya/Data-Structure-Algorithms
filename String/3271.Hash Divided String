class Solution {
public:
    string stringHash(string s, int k) {

        string result = "";

        for (int i = 0; i < s.size(); i += k) {

            int sum = 0;

            // calculate sum for one substring
            for (int j = i; j < i + k; j++) {
                sum += s[j] - 'a';
            }

            result += char((sum % 26) + 'a');
        }

        return result;
    }
};
