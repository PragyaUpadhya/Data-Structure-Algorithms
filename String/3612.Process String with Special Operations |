class Solution {
public:
    string processStr(string s) {
        string result;

        for (char c : s) {
            if (c >= 'a' && c <= 'z') {
                // Add character
                result += c;
            }
            else if (c == '*') {
                // Remove last character
                if (!result.empty()) {
                    result.pop_back();
                }
            }
            else if (c == '#') {
                // Duplicate result
                result += result;
            }
            else if (c == '%') {
                // Reverse result
                reverse(result.begin(), result.end());
            }
        }

        return result;
    }
};
