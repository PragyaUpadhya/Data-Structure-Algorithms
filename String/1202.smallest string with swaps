class Solution {
public:

    vector<int> parent;

    int find(int x) {

        if (parent[x] == x)
            return x;

        return parent[x] = find(parent[x]);
    }

    void unite(int a, int b) {

        int pa = find(a);
        int pb = find(b);

        if (pa != pb)
            parent[pa] = pb;
    }

    string smallestStringWithSwaps(string s,
                                   vector<vector<int>>& pairs) {

        int n = s.size();

        parent.resize(n);

        for (int i = 0; i < n; i++)
            parent[i] = i;

        // Build connected components
        for (auto &p : pairs) {

            unite(p[0], p[1]);
        }

        unordered_map<int, vector<int>> groups;

        // Store indices by parent
        for (int i = 0; i < n; i++) {

            groups[find(i)].push_back(i);
        }

        string ans = s;

        // Process each component
        for (auto &g : groups) {

            vector<int> indices = g.second;

            string chars = "";

            for (int idx : indices) {

                chars += s[idx];
            }

            sort(indices.begin(), indices.end());
            sort(chars.begin(), chars.end());

            for (int i = 0; i < indices.size(); i++) {

                ans[indices[i]] = chars[i];
            }
        }

        return ans;
    }
};
