class Solution {
public:
    int repeatedStringMatch(string a, string b) {
        string repeated = "";
        int count = 0;

        // Repeat until size >= b
        while (repeated.size() < b.size()) {
            repeated += a;
            count++;
        }

        // Check current repetition
        if (repeated.find(b) != string::npos)
            return count;

        // Check one more repetition
        repeated += a;

        if (repeated.find(b) != string::npos)
            return count + 1;

        return -1;
    }
};
