class Solution {
public:
    string firstPalindrome(vector<string>& words) {
        for (string word : words) {
            int left = 0;
            int right = word.size() - 1;
            bool isPalindrome = true;

            while (left < right) {
                if (word[left] != word[right]) {
                    isPalindrome = false;
                    break;
                }
                left++;
                right--;
            }

            if (isPalindrome)
                return word;
        }

        return "";
    }
};
