class Solution {
public:
    bool canChange(string start, string target) {

        int n = start.size();
        int i = 0, j = 0;

        while (i < n || j < n) {

            // Skip blanks
            while (i < n && start[i] == '_')
                i++;

            while (j < n && target[j] == '_')
                j++;

            // Both strings finished
            if (i == n && j == n)
                return true;

            // One finished before the other
            if (i == n || j == n)
                return false;

            // Different pieces
            if (start[i] != target[j])
                return false;

            // L can only move left
            if (start[i] == 'L' && j > i)
                return false;

            // R can only move right
            if (start[i] == 'R' && j < i)
                return false;

            i++;
            j++;
        }

        return true;
    }
};
