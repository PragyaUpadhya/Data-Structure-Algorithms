class Solution {
public:
    int minInsertions(string s) {
        int ans = 0;
        int open = 0;

        for (int i = 0; i < s.size(); i++) {

            if (s[i] == '(') {
                open++;
            }
            else {
                // We have a ')' and need another ')' after it
                if (i + 1 < s.size() && s[i + 1] == ')') {
                    // already have ))
                    i++;
                }
                else {
                    // Need to insert one ')'
                    ans++;
                }

                // This )) closes one '('
                if (open > 0) {
                    open--;
                }
                else {
                    // No '(' to match this ))
                    // Need to insert '('
                    ans++;
                }
            }
        }

        // Every remaining '(' needs two ')'
        ans += open * 2;

        return ans;
    }
};
