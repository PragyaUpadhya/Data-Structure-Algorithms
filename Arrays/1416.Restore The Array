class Solution {
public:

    int mod = 1e9 + 7;
    vector<int> dp;

    int solve(int i, string &s, int k) {

        if (i == s.size())
            return 1;

        if (s[i] == '0')
            return 0;

        if (dp[i] != -1)
            return dp[i];

        long long num = 0;
        long long ways = 0;

        for (int j = i; j < s.size(); j++) {

            num = num * 10 + (s[j] - '0');

            if (num > k)
                break;

            ways = (ways + solve(j + 1, s, k)) % mod;
        }

        return dp[i] = ways;
    }

    int numberOfArrays(string s, int k) {

        dp.resize(s.size(), -1);

        return solve(0, s, k);
    }
};
