class Solution {
public:
    bool canMakeEqual(vector<int>& nums, int k) {
        int n = nums.size();

        for (int target : {1, -1}) {
            vector<int> arr = nums;
            int ops = 0;

            for (int i = 0; i < n - 1; i++) {
                if (arr[i] != target) {
                    arr[i] *= -1;
                    arr[i + 1] *= -1;
                    ops++;
                }
            }

            if (arr[n - 1] == target && ops <= k) {
                return true;
            }
        }

        return false;
    }
};
