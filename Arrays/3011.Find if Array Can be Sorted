class Solution {
public:
    bool canSortArray(vector<int>& nums) {
        vector<int> sorted = nums;
        sort(sorted.begin(), sorted.end());

        int n = nums.size();
        int i = 0;

        while (i < n) {
            int bits = __builtin_popcount(nums[i]);
            int j = i;

            while (j < n && __builtin_popcount(nums[j]) == bits) {
                j++;
            }

            sort(nums.begin() + i, nums.begin() + j);

            i = j;
        }

        return nums == sorted;
    }
};
