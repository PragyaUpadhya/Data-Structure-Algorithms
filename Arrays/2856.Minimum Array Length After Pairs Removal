class Solution {
public:
    int minLengthAfterRemovals(vector<int>& nums) {
        int n = nums.size();
        int i = 0;
        int j = (n + 1) / 2;
        int removed = 0;

        while (i < n / 2 && j < n) {
            if (nums[i] < nums[j]) {
                removed += 2;
                i++;
                j++;
            } else {
                j++;
            }
        }

        return n - removed;
    }
};
