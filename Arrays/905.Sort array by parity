class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {

        int left = 0;
        int right = nums.size() - 1;

        while (left < right) {

            // left should be even
            while (left < right && nums[left] % 2 == 0)
                left++;

            // right should be odd
            while (left < right && nums[right] % 2 == 1)
                right--;

            swap(nums[left], nums[right]);
        }

        return nums;
    }
};
