class Solution {
public:
    int minMoves(vector<int>& nums, int limit) {
        vector<int> diff(2 * limit + 2, 0);

        for (int i = 0; i < nums.size() / 2; i++) {
            int a = nums[i];
            int b = nums[nums.size() - 1 - i];

            int low = min(a, b);
            int high = max(a, b);
            int sum = a + b;

            diff[2] += 2;
            diff[2 * limit + 1] -= 2;

            diff[low + 1]--;
            diff[high + limit + 1]++;

            diff[sum]--;
            diff[sum + 1]++;
        }

        int ans = nums.size();
        int moves = 0;

        for (int sum = 2; sum <= 2 * limit; sum++) {
            moves += diff[sum];
            ans = min(ans, moves);
        }

        return ans;
    }
};
