class Solution {
public:
    long long minEnd(int n, int x) {

        long long ans = x;
        long long num = n - 1;

        for (int i = 0; i < 63; i++) {

            if ((ans & (1LL << i)) == 0) {

                if (num & 1)
                    ans |= (1LL << i);

                num >>= 1;

                if (num == 0)
                    break;
            }
        }

        return ans;
    }
};
