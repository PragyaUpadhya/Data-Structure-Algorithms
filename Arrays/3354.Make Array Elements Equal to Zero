class Solution {
public:
    int countValidSelections(vector<int>& nums) {
        int total = 0;

        for (int x : nums) {
            total += x;
        }

        int left = 0, ans = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] == 0) {
                int right = total - left;

                if (left == right)
                    ans += 2;
                else if (abs(left - right) == 1)
                    ans++;

            } else {
                left += nums[i];
            }
        }

        return ans;
    }
};
