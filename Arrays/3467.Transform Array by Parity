class Solution {
public:
    vector<int> transformArray(vector<int>& nums) {

        // replace even -> 0 , odd -> 1
        for (int i = 0; i < nums.size(); i++) {

            if (nums[i] % 2 == 0)
                nums[i] = 0;
            else
                nums[i] = 1;
        }

        // sort array
        sort(nums.begin(), nums.end());

        return nums;
    }
};
