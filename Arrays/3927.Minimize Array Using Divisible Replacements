class Solution {
public:
    long long minArraySum(vector<int>& nums) {
        int mx = *max_element(nums.begin(), nums.end());

        vector<int> freq(mx + 1, 0);

        for (int x : nums) {
            freq[x]++;
        }

        long long ans = 0;

        for (int i = 1; i <= mx; i++) {
            if (freq[i] == 0) continue;

            for (int j = i; j <= mx; j += i) {
                if (freq[j] > 0) {
                    ans += 1LL * freq[j] * i;
                    freq[j] = 0;
                }
            }
        }

        return ans;
    }
};
